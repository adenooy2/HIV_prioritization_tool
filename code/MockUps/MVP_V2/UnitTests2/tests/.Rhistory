with_intervention_groups(list(
prevention           = ig_new$prevention,
testing              = ig_new$testing,
treatment_monitoring = ig_new$treatment_monitoring,
retention_support    = ig_new$retention_support,
advanced_disease     = ig_new$advanced_disease
))
pops <- calculate_populations(base_ctx())
interv <- zero_interventions()
interv$prep_oral             <- 1000
interv$condoms               <- 100000
interv$vmmc                  <- 5000
interv$test_facility_general <- 10000
interv$test_community        <- 5000
interv$mmd_3month            <- 50
interv$tracking_tracing      <- 40
interv$cd4_testing           <- 92
interv$ahd_package           <- 88
# Install a tracer that prints every int_key as the loop body enters it.
# We do this by wrapping `==` via a base override... actually easiest:
# trace calls to `==` won't work. Use options(error=...) to get a stack dump.
options(error = function() {
cat("\n=== TRACEBACK ===\n")
traceback(2)
cat("\n=== sys.calls() at error ===\n")
print(sys.calls())
cat("\n=== local vars in calculate_scenario_outcomes frame ===\n")
# find the frame
for (n in seq_along(sys.frames())) {
fr <- sys.frames()[[n]]
if (exists("int_key", envir = fr, inherits = FALSE)) {
cat(sprintf("Frame %d: int_key = '%s'\n", n,
get("int_key", envir = fr)))
if (exists("int_key_pre", envir = fr, inherits = FALSE)) {
cat(sprintf("         int_key_pre = '%s'\n",
get("int_key_pre", envir = fr)))
}
if (exists("intervention", envir = fr, inherits = FALSE)) {
cat("         intervention =\n")
print(get("intervention", envir = fr))
}
}
}
})
res <- try(calculate_scenario_outcomes(
base_ctx(), interv, pops, is_baseline = TRUE, baseline_interventions = interv
), silent = FALSE)
options(error = NULL)
expect_true(TRUE)
})
